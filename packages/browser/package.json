{
  "name": "@nexusmc-cn/nexuspulse",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "TypeScript browser notification runtime for Push, Notifications, Service Workers, WebSocket and Badging",
  "license": "MIT",
  "keywords": [
    "nexuspulse",
    "notifications",
    "web-notifications",
    "push-notifications",
    "web-push",
    "webpush",
    "push-api",
    "service-worker",
    "websocket",
    "badging",
    "vapid",
    "pwa",
    "browser",
    "typescript"
  ],
  "homepage": "https://github.com/NexusMC-CN/nexuspulse/tree/main/packages/browser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusMC-CN/nexuspulse.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/NexusMC-CN/nexuspulse/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./service-worker": {
      "import": {
        "types": "./dist/service-worker.d.ts",
        "default": "./dist/service-worker.js"
      },
      "require": {
        "types": "./dist/service-worker.d.cts",
        "default": "./dist/service-worker.cjs"
      }
    },
    "./protocol": {
      "import": {
        "types": "./dist/protocol.d.ts",
        "default": "./dist/protocol.js"
      },
      "require": {
        "types": "./dist/protocol.d.cts",
        "default": "./dist/protocol.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check package.json scripts tests src tsconfig.json tsup.config.ts vitest.config.ts README.md",
    "package:smoke": "node scripts/package-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run format:check",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "@types/node": "^24.7.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
