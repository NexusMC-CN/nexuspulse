{
  "name": "@nexusmc-cn/nexuspulse-server",
  "version": "0.1.2",
  "description": "TypeScript Node.js notification service for Web Push and WebSocket with an optional Fastify adapter",
  "license": "MIT",
  "keywords": [
    "nexuspulse",
    "notifications",
    "push-notifications",
    "web-push",
    "webpush",
    "websocket",
    "fastify",
    "fastify-plugin",
    "notification-service",
    "nodejs",
    "typescript"
  ],
  "homepage": "https://github.com/NexusMC-CN/nexuspulse/tree/main/packages/server#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusMC-CN/nexuspulse.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/NexusMC-CN/nexuspulse/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check package.json tests src tsconfig.json tsup.config.ts vitest.config.ts README.md",
    "check": "npm run typecheck && npm test && npm run format:check",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@fastify/websocket": "^11.3.4",
    "@nexusmc-cn/nexuspulse": "0.1.2",
    "@types/node": "^24.7.2",
    "@types/ws": "^8.18.2",
    "fastify": "^5.12.5",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "fastify-plugin": "^5.1.0"
  },
  "peerDependencies": {
    "@nexusmc-cn/nexuspulse": "^0.1.1",
    "fastify": ">=5.0.0 <6.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
