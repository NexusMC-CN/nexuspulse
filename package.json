{
  "name": "nexuspulse-workspace",
  "private": true,
  "workspaces": [
    "packages/browser",
    "packages/server"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "format:check": "npm run format:check --workspaces",
    "format:root": "prettier --check package.json README.md",
    "check": "npm run typecheck --workspaces && npm test --workspaces && npm run format:check --workspaces && npm run format:root"
  }
}
