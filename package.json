{
  "name": "nexuspulse",
  "version": "0.1.0",
  "description": "SSR-safe Nexus event and service worker utilities",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./service-worker": {
      "types": "./dist/service-worker.d.ts",
      "import": "./dist/service-worker.js",
      "require": {
        "types": "./dist/service-worker.d.cts",
        "default": "./dist/service-worker.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check package.json scripts tests src tsconfig.json tsup.config.ts vitest.config.ts README.md",
    "package:smoke": "node scripts/package-smoke.mjs",
    "check": "npm run typecheck && npm test && npm run format:check",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "@types/node": "^24.7.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
