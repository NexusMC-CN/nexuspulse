{
  "name": "nexuspulse-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/browser",
    "packages/server"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "format:check": "npm run format:check --workspaces",
    "format:root": "prettier --check package.json README.md CHANGELOG.md .github/workflows/ci.yml",
    "check": "npm run typecheck --workspaces && npm test --workspaces && npm run format:check --workspaces && npm run format:root"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
